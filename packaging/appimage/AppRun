#!/bin/sh
set -e

HERE="$(dirname "$(readlink -f "${0}")")"
export APPDIR="${HERE}"

# Add AppDir paths to environment
export PATH="${APPDIR}/usr/bin:${PATH}"
export PYTHONPATH="${APPDIR}/usr/lib/python3/site-packages:${APPDIR}/usr/share/adorn:${PYTHONPATH:-}"
export XDG_DATA_DIRS="${APPDIR}/usr/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"

if [ -d "${APPDIR}/usr/lib/girepository-1.0" ]; then
    export GI_TYPELIB_PATH="${APPDIR}/usr/lib/girepository-1.0:${GI_TYPELIB_PATH:-}"
fi

# Locate Python 3 binary (bundled ELF or host python3)
if [ -f "${APPDIR}/usr/bin/python3" ] && head -c 4 "${APPDIR}/usr/bin/python3" 2>/dev/null | grep -q "ELF"; then
    PYTHON_BIN="${APPDIR}/usr/bin/python3"
elif command -v python3 >/dev/null 2>&1; then
    PYTHON_BIN="$(command -v python3)"
elif command -v python >/dev/null 2>&1; then
    PYTHON_BIN="$(command -v python)"
else
    echo "Error: Python 3 not found on host system. Python 3 is required to run Adorn." >&2
    exit 1
fi

# Launch application
exec "${PYTHON_BIN}" "${APPDIR}/usr/bin/adorn" "$@"
